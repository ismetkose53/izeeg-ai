# ==============================================================================
# 🚀 E-ASİSTAN PRO AI - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Bu dosya, canlı pazaryeri ve e-fatura API bağlantıları için gerekli olan
# tüm environment (ortam) değişkenlerinin şablonudur.
# Canlıya alırken bu dosyayı `.env` olarak kopyalayın ve gerçek anahtarlarınızı girin.
# ==============================================================================

# 1. UYGULAMA GENEL AYARLARI
PORT=3000
NODE_ENV=production
VITE_APP_NAME="E-Asistan PRO AI"
VITE_APP_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:5000/api/v1

# 2. AI MODEL VE LLM MOTORU (GEMINI / OPENAI)
GEMINI_API_KEY=AIzaSy...your_google_gemini_api_key
GEMINI_MODEL=gemini-1.5-pro
AI_WORKER_AUTONOMOUS_MODE=false # true: Otomatik uygular, false: Güvenlik Kapısı (Onay İster)

# 3. TRENDYOL PARTNER API
TRENDYOL_SELLER_ID=149204
TRENDYOL_API_KEY=tpa_live_your_trendyol_api_key
TRENDYOL_API_SECRET=your_trendyol_api_secret_hash
TRENDYOL_STAGE=production # sandbox | production
TRENDYOL_WEBHOOK_SECRET=your_trendyol_webhook_secret

# 4. HEPSİBURADA MERCHANT API
HEPSIBURADA_MERCHANT_ID=merch_9481029
HEPSIBURADA_SECRET_KEY=your_hepsiburada_secret_key
HEPSIBURADA_BASE_URL=https://mpop.hepsiburada.com

# 5. AMAZON SP-API (SELLING PARTNER API)
AMAZON_SELLER_ID=A28190XTY12
AMAZON_CLIENT_ID=amzn1.application-oa2-client.your_client_id
AMAZON_CLIENT_SECRET=your_amazon_client_secret
AMAZON_REFRESH_TOKEN=Atzr|your_amazon_sp_api_refresh_token
AMAZON_AWS_ACCESS_KEY_ID=AKIA...your_aws_access_key
AMAZON_AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AMAZON_AWS_REGION=eu-west-1
AMAZON_MARKETPLACE_ID=A33AVAJ2PDY3EV # Amazon TR Marketplace ID

# 6. N11 ENTEGRASYON API
N11_API_KEY=your_n11_api_key
N11_API_SECRET=your_n11_api_secret

# 7. TİCİMAX E-TİCARET SİSTEMİ API
TICIMAX_DOMAIN_URL=https://magaza.ticimax.com
TICIMAX_WS_USERNAME=your_ticimax_webservice_username
TICIMAX_WS_PASSWORD=your_ticimax_webservice_password

# 8. SHOPIFY E-TİCARET SİTESİ API
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_your_shopify_admin_access_token
SHOPIFY_API_VERSION=2024-04

# 9. RESMİ E-FATURA & E-ARŞİV ENTEGRATÖRLERİ
# 9.1. Paraşüt API
PARASUT_COMPANY_ID=182904
PARASUT_CLIENT_ID=your_parasut_client_id
PARASUT_CLIENT_SECRET=your_parasut_client_secret
PARASUT_USERNAME=fatura@sirketiniz.com
PARASUT_PASSWORD=your_parasut_password

# 9.2. BizimHesap API
BIZIMHESAP_APP_KEY=your_bizimhesap_app_key
BIZIMHESAP_TOKEN=your_bizimhesap_token

# 9.3. GİB (Gelir İdaresi Başkanlığı) Doğrudan Portal
GIB_PORTAL_VKN=1829048192
GIB_PORTAL_PASSWORD=your_gib_portal_password

# 10. WHATSAPP BUSINESS & BÜLTEN BİLDİRİM BOTU
WHATSAPP_PROVIDER=META # META | TWILIO
META_WHATSAPP_PHONE_NUMBER_ID=1092849102948
META_WHATSAPP_ACCESS_TOKEN=EAAG...your_whatsapp_system_user_token
WHATSAPP_MANAGER_PHONE=+905321234567 # Bildirimlerin gideceği yönetici numarası

# 11. VERİTABANI & GÜVENLİK
DATABASE_URL=postgresql://postgres:password@localhost:5432/easistan_db
JWT_SECRET=super_secret_jwt_key_for_session_encryption_256bit
ENCRYPTION_KEY_32BYTES=your_32_bytes_aes_key_for_api_keys_encryption
